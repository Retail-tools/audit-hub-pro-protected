{
  "version": 2,
  "routes": [
    {
      "src": "/tools/(.*)",
      "dest": "/tools/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/data/(.*)",
      "dest": "/data/$1"
    },
    {
      "src": "/(.*).html",
      "dest": "/$1.html"
    },
    {
      "src": "/(?!login\\.html|.*\\..*$)(.*)",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/login.html"
    }
  ]
}
